# Public portfolio configuration template
# Copy this file to .env and provide your own development values.

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Settlement currency, chosen once at installation and never changed: PLN or EUR.
SHOP_CURRENCY=EUR

# Database
DATABASE_URL=postgres://your_user:your_password@localhost:5432/car_rental

# Authentication
AUTH_SECRET=generate_with_openssl_rand_base64_32
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=generate_with_openssl_rand_base64_32

# File storage
# STORAGE_DRIVER=s3 in production (Hetzner Object Storage, private bucket).
# "local" writes to UPLOAD_DIR for development only. All uploads (documents,
# invoices, signatures, media) go through the same driver.
STORAGE_DRIVER=local
UPLOAD_DIR=./.storage
# Hetzner example: S3_ENDPOINT=https://<region>.your-objectstorage.com, S3_REGION=<region>
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# Email and notifications
RESEND_API_KEY=
EMAIL_FROM=your-email@example.com
BOOKING_NOTIFY_TO=
REMINDER_NOTIFY_TO=
REMINDERS_SECRET=generate_a_unique_random_value

# Bot protection and AI assistant
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
CF_ACCOUNT_ID=
CF_AI_TOKEN=
CF_AI_MODEL=

# Analytics
NEXT_PUBLIC_GA4_ID=
GOOGLE_SITE_VERIFICATION=

# Development administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=choose_a_strong_development_password
ADMIN_NAME=Your Name
