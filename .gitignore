# See https://help.github.com/articles/ignoring-files/

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
/dist

# misc
.DS_Store
Thumbs.db

# logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — only .env.example is committed
.env
.env.*
!.env.example

# secrets / certificates
*.pem
*.key
*.crt
*.p12
*.pfx

# databases and dumps
*.db
*.sqlite
*.sqlite3
*.sql.gz
*.dump

# local dev storage / user uploads
.storage/
uploads/
media/

# python (if tooling is added)
venv/
.venv/
__pycache__/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# editors, workspaces and AI agent tooling
.vscode/
.idea/
.claude/
.claude-*
CLAUDE.md
AGENTS.md
.agent/
.agents/
.codex/
.cursor/
memory/
memories/
